{
  "listType": "List",
  "definitions": [
    {
      "name": "Column",
      "description": "Data contract column with parameterized type tags",
      "template": {
        "$type": {
          "discriminator": "type",
          "variantMatch": "regex",
          "variantNames": {
            "^Decimal(\\((\\d{1,2}),(\\d{1,2})\\))?$": "DecimalColumn",
            "^Varchar$": "VarcharColumn"
          },
          "variants": {
            "^Decimal(\\((\\d{1,2}),(\\d{1,2})\\))?$": { "scale": "int" },
            "^Varchar$": {}
          }
        }
      }
    }
  ]
}
